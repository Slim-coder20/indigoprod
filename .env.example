# Connexion à la base Supabase "indigoProduction".
# Supabase > projet > bouton "Connect" > onglet "ORMs" / "Connection string".
# Remplacez [PROJECT-REF], [DB-PASSWORD] et [REGION] par les vraies valeurs.

# Pooler en mode Transaction (port 6543) : utilisé par le site (Prisma Client)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Pooler en mode Session (port 5432) : utilisé par le CLI Prisma (migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Resend (formulaire de contact) — https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Destinataire des messages (par défaut : l'email de lib/contact.ts)
CONTACT_TO_EMAIL="contact.indigoprod@gmail.com"
# Expéditeur : une adresse d'un domaine vérifié dans Resend.
# Sans domaine vérifié, onboarding@resend.dev n'envoie qu'à l'email du compte Resend.
CONTACT_FROM_EMAIL="Site Indigo <onboarding@resend.dev>"

# Stripe (paiement boutique) — https://dashboard.stripe.com/test/apikeys
# Clés de TEST (sk_test_ / pk_test_) tant que la mise en production n'est pas faite.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Secret du webhook (stripe listen en local, endpoint du dashboard en prod)
STRIPE_WEBHOOK_SECRET="whsec_..."
# URL publique du site, utilisée pour les URLs de retour de Stripe
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
